generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum FacilityType {
  FKTP
  KLINIK
  RS_C
  RS_D

  @@map("facility_type")
}

enum TariffScheme {
  INA_CBG
  IDRG

  @@map("tariff_scheme")
}

enum ClaimStatus {
  DRAFT
  IMPORTED
  SCORING
  SCORED
  SCORING_FAILED
  UNDER_REVIEW
  READY_TO_SUBMIT
  NEEDS_CORRECTION
  REPORTED
  SUBMITTED
  CLOSED

  @@map("claim_status")
}

enum RiskBand {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("risk_band")
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("severity")
}

enum UserRole {
  VERIFIER
  CODER
  MANAGER
  GOVERNANCE
  ADMIN
  SUPER_ADMIN

  @@map("user_role")
}

enum ReportStatus {
  NEW
  TRIAGED
  INVESTIGATING
  RESOLVED
  CLOSED
  REJECTED

  @@map("report_status")
}

enum AnonymityMode {
  ANONYMOUS
  CONFIDENTIAL
  IDENTIFIED

  @@map("anonymity_mode")
}

enum RulepackStatus {
  DRAFT
  ACTIVE
  RETIRED

  @@map("rulepack_status")
}

enum ModelStatus {
  STAGING
  SHADOW
  ACTIVE
  RETIRED

  @@map("model_status")
}

enum DecisionType {
  APPROVE
  CORRECT
  ESCALATE
  REPORT

  @@map("decision_type")
}

model Tenant {
  id           String       @id @default(uuid(7)) @db.Uuid
  name         String       @db.VarChar(160)
  facilityType FacilityType @map("facility_type")
  regionCode   String       @map("region_code") @db.VarChar(16)
  bedCount     Int?         @map("bed_count")
  hasIcu       Boolean      @default(false) @map("has_icu")
  rmeMaturity  String?      @map("rme_maturity") @db.VarChar(16)
  tariffScheme TariffScheme @default(INA_CBG) @map("tariff_scheme")
  status       String       @default("ACTIVE") @db.VarChar(16)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  users       User[]
  patients    Patient[]
  claims      Claim[]
  evaluations ClaimEvaluation[]
  decisions   Decision[]
  reports     Report[]

  @@index([status, facilityType])
  @@map("tenants")
}

model User {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  email            String    @unique @db.VarChar(320)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  role             UserRole
  status           String    @default("ACTIVE") @db.VarChar(16)
  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  mfaSecretEnc     Bytes?    @map("mfa_secret_enc")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  refreshTokens     RefreshToken[]
  claimsCreated     Claim[]        @relation("ClaimCreatedBy")
  documentsUploaded ClaimDocument[]
  decisions         Decision[]
  reportEvents      ReportEvent[]
  reportsAssigned   Report[]       @relation("ReportAssignedTo")
  rulepacksCreated  Rulepack[]

  @@index([tenantId, role])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  familyId   String    @map("family_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Patient {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  patientRef   String   @map("patient_ref") @db.VarChar(64)
  ageBand      String?  @map("age_band") @db.VarChar(16)
  sex          String?  @db.VarChar(1)
  chronicFlags Json     @default("[]") @map("chronic_flags") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  claims Claim[]

  @@unique([tenantId, patientRef])
  @@map("patients")
}

model Claim {
  id                 String       @id @default(uuid(7)) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  patientId          String       @map("patient_id") @db.Uuid
  claimRef           String       @map("claim_ref") @db.VarChar(64)
  sepRef             String?      @map("sep_ref") @db.VarChar(64)
  facilityType       FacilityType @map("facility_type")
  admissionDate      DateTime     @map("admission_date") @db.Date
  dischargeDate      DateTime     @map("discharge_date") @db.Date
  primaryDiagnosis   String       @map("primary_diagnosis") @db.VarChar(16)
  secondaryDiagnoses Json         @default("[]") @map("secondary_diagnoses") @db.JsonB
  procedures         Json         @default("[]") @db.JsonB
  drgCode            String?      @map("drg_code") @db.VarChar(32)
  tariffScheme       TariffScheme @map("tariff_scheme")
  tariffVersion      String       @map("tariff_version") @db.VarChar(32)
  class              String?      @db.VarChar(8)
  losDays            Int          @map("los_days")
  totalCost          Decimal      @map("total_cost") @db.Decimal(14, 2)
  costBreakdown      Json         @default("{}") @map("cost_breakdown") @db.JsonB
  dischargeStatus    String?      @map("discharge_status") @db.VarChar(32)
  status             ClaimStatus  @default(DRAFT)
  riskScore          Decimal?     @map("risk_score") @db.Decimal(5, 2)
  riskBand           RiskBand?    @map("risk_band")
  submittedAt        DateTime?    @map("submitted_at") @db.Timestamptz(6)
  createdBy          String?      @map("created_by") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int          @default(1)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  creator     User?             @relation("ClaimCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  items       ClaimItem[]
  documents   ClaimDocument[]
  evaluations ClaimEvaluation[]
  decisions   Decision[]
  reports     Report[]

  @@unique([tenantId, claimRef])
  @@index([tenantId, status])
  @@index([tenantId, admissionDate(sort: Desc)])
  @@index([patientId, admissionDate(sort: Desc)])
  @@index([tenantId, riskBand, riskScore(sort: Desc)])
  @@index([tenantId, drgCode])
  @@map("claims")
}

model ClaimItem {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  claimId     String    @map("claim_id") @db.Uuid
  itemType    String    @map("item_type") @db.VarChar(16)
  itemCode    String?   @map("item_code") @db.VarChar(64)
  description String    @db.VarChar(255)
  quantity    Decimal   @db.Decimal(12, 3)
  unit        String    @db.VarChar(16)
  unitPrice   Decimal   @map("unit_price") @db.Decimal(14, 2)
  totalPrice  Decimal   @map("total_price") @db.Decimal(14, 2)
  serviceDate DateTime? @map("service_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([tenantId])
  @@map("claim_items")
}

model ClaimDocument {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  claimId      String   @map("claim_id") @db.Uuid
  documentType String   @map("document_type") @db.VarChar(32)
  storageKey   String   @map("storage_key") @db.VarChar(255)
  sha256       String   @db.VarChar(64)
  sizeBytes    BigInt   @map("size_bytes")
  contentType  String   @map("content_type") @db.VarChar(128)
  uploadedBy   String?  @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  claim    Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  uploader User? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([claimId])
  @@index([tenantId])
  @@map("claim_documents")
}

model Rulepack {
  id            String         @id @default(uuid(7)) @db.Uuid
  rulepackId    String         @map("rulepack_id") @db.VarChar(64)
  version       String         @db.VarChar(32)
  status        RulepackStatus @default(DRAFT)
  effectiveFrom DateTime       @map("effective_from") @db.Date
  effectiveTo   DateTime?      @map("effective_to") @db.Date
  checksum      String         @db.VarChar(80)
  definition    Json           @db.JsonB
  createdBy     String?        @map("created_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  activatedAt   DateTime?      @map("activated_at") @db.Timestamptz(6)
  retiredAt     DateTime?      @map("retired_at") @db.Timestamptz(6)

  creator User?            @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  rules   RuleDefinition[]

  @@unique([rulepackId, version])
  @@index([rulepackId, status])
  @@map("rulepacks")
}

model RuleDefinition {
  id        String   @id @default(uuid(7)) @db.Uuid
  rulepack  String   @map("rulepack_ref") @db.Uuid
  ruleId    String   @map("rule_id") @db.VarChar(64)
  version   String   @db.VarChar(32)
  mode      String   @db.VarChar(32)
  severity  Severity
  weight    Decimal  @db.Decimal(5, 2)
  ruleGroup String   @map("rule_group") @db.VarChar(32)
  condition Json     @db.JsonB
  evidence  Json     @default("[]") @db.JsonB
  message   String   @db.VarChar(500)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rulepackRef Rulepack @relation(fields: [rulepack], references: [id], onDelete: Cascade)

  @@unique([rulepack, ruleId])
  @@index([rulepack, enabled])
  @@map("rule_definitions")
}

model ClaimEvaluation {
  id              String   @id @default(uuid(7)) @db.Uuid
  claimId         String   @map("claim_id") @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  rulepackVersion String   @map("rulepack_version") @db.VarChar(32)
  modelVersion    String?  @map("model_version") @db.VarChar(64)
  ruleScore       Decimal  @map("rule_score") @db.Decimal(5, 2)
  mlScore         Decimal? @map("ml_score") @db.Decimal(6, 5)
  finalScore      Decimal  @map("final_score") @db.Decimal(5, 2)
  riskBand        RiskBand @map("risk_band")
  firedRules      Json     @default("[]") @map("fired_rules") @db.JsonB
  topFeatures     Json     @default("[]") @map("top_features") @db.JsonB
  similarEpisodes Json     @default("[]") @map("similar_episodes") @db.JsonB
  dataQuality     Decimal  @default(1) @map("data_quality") @db.Decimal(4, 3)
  mlStatus        String   @default("OK") @map("ml_status") @db.VarChar(16)
  latencyMs       Int?     @map("latency_ms")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  claim     Claim            @relation(fields: [claimId], references: [id], onDelete: Cascade)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  decisions Decision[]

  @@index([claimId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("claim_evaluations")
}

model Decision {
  id           String       @id @default(uuid(7)) @db.Uuid
  claimId      String       @map("claim_id") @db.Uuid
  evaluationId String?      @map("evaluation_id") @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  actorId      String       @map("actor_id") @db.Uuid
  decision     DecisionType
  rationale    String       @db.VarChar(2000)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  claim      Claim            @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evaluation ClaimEvaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor      User             @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([claimId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("decisions")
}

model Report {
  id                 String        @id @default(uuid(7)) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  claimId            String?       @map("claim_id") @db.Uuid
  trackingCodeHash   String        @unique @map("tracking_code_hash") @db.VarChar(64)
  category           String        @db.VarChar(32)
  descriptionEnc     Bytes         @map("description_enc")
  evidenceRefs       Json          @default("[]") @map("evidence_refs") @db.JsonB
  anonymityMode      AnonymityMode @map("anonymity_mode")
  reporterContactEnc Bytes?        @map("reporter_contact_enc")
  status             ReportStatus  @default(NEW)
  priority           String        @default("NORMAL") @db.VarChar(16)
  assignedTo         String?       @map("assigned_to") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  closedAt           DateTime?     @map("closed_at") @db.Timestamptz(6)

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  claim    Claim?       @relation(fields: [claimId], references: [id], onDelete: SetNull)
  assignee User?        @relation("ReportAssignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)
  events   ReportEvent[]
  tracking ReportTracking?

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("reports")
}

model ReportTracking {
  reportId         String       @id @map("report_id") @db.Uuid
  trackingCodeHash String       @unique @map("tracking_code_hash") @db.VarChar(64)
  status           ReportStatus @default(NEW)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("report_tracking")
}

model ReportEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(32)
  noteEnc   Bytes?   @map("note_enc")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
  @@index([tenantId])
  @@map("report_events")
}

model AuditLog {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  action        String   @db.VarChar(64)
  resourceType  String   @map("resource_type") @db.VarChar(32)
  resourceId    String   @map("resource_id") @db.VarChar(64)
  beforeHash    String?  @map("before_hash") @db.VarChar(64)
  afterHash     String?  @map("after_hash") @db.VarChar(64)
  metadata      Json     @default("{}") @db.JsonB
  ipHash        String?  @map("ip_hash") @db.VarChar(64)
  userAgentHash String?  @map("user_agent_hash") @db.VarChar(64)
  prevHash      String?  @map("prev_hash") @db.VarChar(64)
  entryHash     String   @map("entry_hash") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("audit_log")
}

model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(32)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(64)
  payload       Json      @db.JsonB
  status        String    @default("PENDING") @db.VarChar(16)
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("outbox_events")
}

model ModelVersion {
  id          String      @id @default(uuid(7)) @db.Uuid
  modelName   String      @map("model_name") @db.VarChar(64)
  version     String      @db.VarChar(64)
  status      ModelStatus @default(STAGING)
  artifactUri String      @map("artifact_uri") @db.VarChar(255)
  checksum    String      @db.VarChar(128)
  metrics     Json        @default("{}") @db.JsonB
  trainedAt   DateTime?   @map("trained_at") @db.Timestamptz(6)
  activatedAt DateTime?   @map("activated_at") @db.Timestamptz(6)
  retiredAt   DateTime?   @map("retired_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([modelName, version])
  @@index([modelName, status])
  @@map("model_versions")
}

model IdempotencyKey {
  key            String   @db.VarChar(128)
  tenantId       String   @map("tenant_id") @db.Uuid
  method         String   @db.VarChar(8)
  path           String   @db.VarChar(255)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([tenantId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model LkppPrice {
  id         String    @id @default(uuid(7)) @db.Uuid
  itemCode   String    @map("item_code") @db.VarChar(64)
  itemName   String    @map("item_name") @db.VarChar(255)
  unit       String    @db.VarChar(16)
  price      Decimal   @db.Decimal(14, 2)
  regionCode String    @default("NATIONAL") @map("region_code") @db.VarChar(16)
  validFrom  DateTime  @map("valid_from") @db.Date
  validTo    DateTime? @map("valid_to") @db.Date
  sourceUrl  String?   @map("source_url") @db.VarChar(255)
  fetchedAt  DateTime  @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@unique([itemCode, regionCode, validFrom])
  @@map("lkpp_prices")
}